{
 "name": "m2_smoke",
 "_comment": [
  "M2 tripwire (NOT QUOTABLE): bf vs bf_nofull vs stock, direct I/O, 32 MiB ring;",
  "checks full_page_* counters move on zipf-raw and the scan arm runs end to end."
 ],
 "datasets": {
  "v100": {
   "records": 4000000,
   "value_len": 100,
   "key_spacing": 16
  }
 },
 "defaults": {
  "dataset": "v100",
  "repeats": 1,
  "seconds": 15,
  "warmup_ops": 200000,
  "theta": 0.9,
  "synchronous": "normal",
  "journal": "wal",
  "ops_per_txn": 1,
  "read_txn": true,
  "drop_cache": true,
  "budget_bytes": "36M",
  "memmax": "auto",
  "promotion": 30,
  "copy_on_access": 10,
  "workload": "read=100",
  "direct_io": true
 },
 "experiments": [
  {
   "name": "read_zipf",
   "dist": "zipf",
   "suts": [
    "stock",
    "bf",
    "bf_nofull"
   ],
   "ring_bytes": "32M"
  },
  {
   "name": "read_zipfraw",
   "dist": "zipf-raw",
   "suts": [
    "stock",
    "bf",
    "bf_nofull"
   ],
   "ring_bytes": "32M"
  },
  {
   "name": "scan_zipfraw",
   "workload": "scan=100",
   "dist": "zipf-raw",
   "scan_len": 32,
   "warmup_ops": 50000,
   "suts": [
    "stock",
    "bf",
    "bf_nofull"
   ],
   "ring_bytes": "32M"
  }
 ]
}